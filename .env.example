CAM_URL=rtsp://<ip-ou-host>:554/Streaming/Channels/101
CAM_USER=<usuario-somente-leitura>
CAM_PASS=<senha-no-cofre>
# Banco do módulo de acompanhamento (Fase 3) — opcional na 0-A
DATABASE_URL=
